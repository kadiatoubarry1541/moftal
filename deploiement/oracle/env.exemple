# ─────────────────────────────────────────────────────────────────────────────
# Moftal sur Oracle — copier ce fichier en « .env » (même dossier) et le remplir.
# NE JAMAIS envoyer .env sur GitHub (il est ignoré). Gardez-en une copie à l'abri.
# Les valeurs à reprendre de Render : Render → votre service → « Environment ».
# ─────────────────────────────────────────────────────────────────────────────

# Base de données locale : laissez vide, l'installateur génère un mot de passe sûr
# (lettres et chiffres seulement si vous le choisissez vous-même)
DB_PASSWORD=

# Adresse de la base actuelle sur Neon — servira UNE fois, pour transférer les données
NEON_DATABASE_URL=

# ── À copier depuis Render (mêmes noms, mêmes valeurs) ───────────────────────
JWT_SECRET=
FRONTEND_URL=https://moftal.com
CORS_ORIGIN=
ADMIN_NUMERO_H=
SUPER_ADMIN_PASSWORD=
BACKEND_URL=https://api.moftal.com
# Tout autre réglage présent sur Render (et absent ici) : le copier aussi, tel quel.

# Stockage des fichiers (photos, vidéos, vocaux)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
IDRIVE_ENDPOINT=
IDRIVE_REGION=
IDRIVE_ACCESS_KEY=
IDRIVE_SECRET_KEY=
IDRIVE_BUCKET=
# (anciens stockages, seulement s'ils sont remplis sur Render)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# E-mails
FROM_EMAIL=noreply@moftal.com
FROM_NAME=Moftal
BREVO_API_KEY=
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
MAILERSEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASS=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
RESEND_API_KEY=

# Notifications sur le téléphone
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Paiements Djomy
DJOMY_CLIENT_ID=
DJOMY_CLIENT_SECRET=
DJOMY_ENV=

# Assistant (facultatif)
HF_TOKEN=

# Sauvegarde de nuit : mot de passe de chiffrement des copies — LE MÊME que le
# secret GitHub SAUVEGARDE_CLE. À garder aussi sur papier : sans lui, les copies
# ne peuvent pas être relues.
SAUVEGARDE_CLE=
