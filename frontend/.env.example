# ─── Frontend — Variables d'environnement ────────────────────────────────────
# Copiez ce fichier en .env (dev) ou .env.production (prod) et remplissez.
# NE COMMITEZ JAMAIS .env ou .env.production (ils peuvent contenir des secrets).

# URL de l'API backend
# Dev  → http://localhost:5002
# Prod → https://votre-backend.onrender.com
VITE_API_URL=http://localhost:5002

# Anti-robot (Cloudflare Turnstile, gratuit) : clé du SITE (publique).
# Vide = vérification désactivée. Mettre la clé secrète côté serveur
# (TURNSTILE_SECRET_KEY) en même temps.
VITE_TURNSTILE_SITE_KEY=
